# SeatRota container environment. Copy to seatrota.env and fill in.
# Generate secrets with: openssl rand -base64 32   (encryption key: openssl rand -hex 16)

# Core (required)
DATABASE_URL=postgresql://seatrota:seatrota@database:5432/seatrota
DATABASE_DIRECT_URL=postgresql://seatrota:seatrota@database:5432/seatrota
NEXTAUTH_SECRET=change-me
# Exactly 32 bytes; it encrypts stored secrets such as SSO client secrets.
CALENDSO_ENCRYPTION_KEY=change-me-to-32-bytes-0123456789
# Must match the NEXT_PUBLIC_WEBAPP_URL build argument of the image.
NEXT_PUBLIC_WEBAPP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Reminder emails (POST /api/cron/teams-reminders with this key)
CRON_API_KEY=change-me
EMAIL_FROM=notifications@example.com
EMAIL_SERVER_HOST=smtp.example.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=

# SSO plan flag (on by default for self-host)
SEATROTA_SSO_ENABLED=1

# Hosted mode: requires https outside localhost and a CRON_API_KEY.
SEATROTA_HOSTED=0

# Per-seat billing, Stripe TEST mode only. A live key (sk_live_...) is refused at startup.
SEATROTA_BILLING_ENABLED=0
STRIPE_SECRET_KEY=sk_test_replace_me
SEATROTA_STRIPE_WEBHOOK_SECRET=whsec_replace_me
SEATROTA_STRIPE_SEAT_PRICE_ID=price_replace_me
SEATROTA_BILLING_TRIAL_DAYS=0
