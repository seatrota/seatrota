{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "declaration": true,
    "outDir": "dist",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "index.ts",
    "plan.ts",
    "roles.ts",
    "domain.ts",
    "enforce.ts",
    "provider-id.ts",
    "oidc-provider.ts"
  ],
  "exclude": ["dist", "**/*.test.ts", "**/*.e2e.ts", "vitest.config.ts", "vitest.e2e.config.ts"]
}
