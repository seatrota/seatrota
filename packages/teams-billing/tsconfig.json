{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "declaration": true,
    "outDir": "dist",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["index.ts", "config.ts", "seats.ts", "stripe-gateway.ts", "webhook-signature.ts", "check-env.ts"],
  "exclude": ["dist", "**/*.test.ts", "vitest.config.ts"]
}
